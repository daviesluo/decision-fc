# Throwaway diagnostics. A scratch probe leaked into main once via `git add -A`.
tools/tmp/

# Generated by `node tools/build-edge.mjs` from packages/engine + packages/content.
# It was tracked once and drifted from its own source within days: nothing in the
# repo could keep 3,800 generated lines honest, so what a reader opened was
# engine logic that no longer matched the engine. CI builds it; the deploy
# uploads it; the checked-out tree does not carry it.
packages/backend/edge/engine-bundle.mjs

# The itch.io build (`pnpm build:itch`). Same source as `dist/`, different base
# URL — untracked for the same reason `dist/` is. What *is* tracked is the zip
# it produces, in `itch/`, because that is a deliverable somebody uploads by
# hand rather than something a machine rebuilds on demand.
apps/web/dist-itch/

# Every screenshot run's frames, kept so a published set can be picked frame by
# frame across runs (`tools/itch-assets.mjs`). Local only.
itch/takes/
