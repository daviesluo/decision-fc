    <xhtml:link rel="alternate" hreflang="zh-Hans" href="https://decisionfc.com/zh/" />
    <xhtml:link rel="alternate" hreflang="x-default" href="https://decisionfc.com/" />
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
